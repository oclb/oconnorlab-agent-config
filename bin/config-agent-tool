#!/usr/bin/env python3
"""Manage the lab agent configuration checkout for Claude Code or Codex."""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path


GENERATED_MARKER = "Generated by lab-agent-config/bin/config-agent-tool"
OLD_CODEX_MARKER = "Generated by codex-config/bin/config-agent-tool"
OLD_CODEX_MARKER_2 = "Generated by codex-config/scripts/render-agents-override.sh"
AGENTS = {"claude", "codex"}
CODEX_UPDATE_HOOK_COMMAND = 'sh -c \'exec "${CODEX_HOME:-$HOME/.codex}/hooks/update-config.sh"\''
CLAUDE_PLUGIN_NAME = "lab-config"
CLAUDE_LEGACY_HOOK_COMMANDS = {
    "~/.claude/hooks/update-config.sh",
    "~/.claude/hooks/memory-reminder.sh",
    "~/.claude/hooks/notify.sh 'Claude Code' 'Awaiting your input'",
}


class CodexHooksFragmentError(ValueError):
    """A configured Codex hooks fragment could not be merged safely."""


@dataclass(frozen=True)
class AgentConfig:
    name: str
    root: Path

    @property
    def global_prompt(self) -> Path:
        if self.name == "claude":
            return self.root / "global" / "CLAUDE.md"
        return self.root / "global" / "AGENTS.md"

    @property
    def skills_root(self) -> Path:
        return self.root / "skills"


@dataclass(frozen=True)
class Skill:
    name: str
    path: Path
    recommended_scope: str
    description: str


def repo_dir() -> Path:
    return Path(__file__).resolve().parents[1]


def agent_config(name: str) -> AgentConfig:
    if name not in AGENTS:
        raise SystemExit(f"Unknown agent: {name}")
    return AgentConfig(name=name, root=repo_dir() / name)


def codex_dir() -> Path:
    return Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()


def claude_dir() -> Path:
    return Path(os.environ.get("CLAUDE_HOME", "~/.claude")).expanduser()


def project_dir() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        return Path(result.stdout.strip()).resolve()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return Path.cwd().resolve()


def git_pull_ff_only() -> None:
    command = ["git", "-C", str(repo_dir()), "pull", "--ff-only"]
    process = subprocess.Popen(command)
    old_term = signal.getsignal(signal.SIGTERM)
    old_int = signal.getsignal(signal.SIGINT)

    def terminate_child(signum, frame) -> None:
        with contextlib.suppress(ProcessLookupError):
            process.terminate()
        try:
            process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(ProcessLookupError):
                process.kill()
            process.wait()
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, terminate_child)
    signal.signal(signal.SIGINT, terminate_child)
    try:
        returncode = process.wait()
    finally:
        signal.signal(signal.SIGTERM, old_term)
        signal.signal(signal.SIGINT, old_int)
    if returncode != 0:
        raise subprocess.CalledProcessError(returncode=returncode, cmd=command)


def parse_frontmatter(path: Path) -> dict[str, str]:
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0].strip() != "---":
        return {}

    data: dict[str, str] = {}
    for line in lines[1:]:
        if line.strip() == "---":
            break
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip().strip("\"'")
    return data


def skills(config: AgentConfig) -> list[Skill]:
    found: list[Skill] = []
    for skill_md in sorted(config.skills_root.glob("*/SKILL.md")):
        frontmatter = parse_frontmatter(skill_md)
        name = frontmatter.get("name") or skill_md.parent.name
        scope = frontmatter.get("recommended_scope", "none")
        if scope not in {"global", "project", "none"}:
            raise SystemExit(f"Invalid recommended_scope for {skill_md}: {scope}")
        found.append(
            Skill(
                name=name,
                path=skill_md.parent,
                recommended_scope=scope,
                description=frontmatter.get("description", ""),
            )
        )
    return found


def skill_map(config: AgentConfig) -> dict[str, Skill]:
    return {skill.name: skill for skill in skills(config)}


def target_skills_dir(config: AgentConfig, global_scope: bool) -> Path:
    if config.name == "claude":
        return claude_dir() / "skills" if global_scope else project_dir() / ".claude" / "skills"
    return codex_dir() / "skills" if global_scope else project_dir() / ".agents" / "skills"


def symlink_target(path: Path) -> Path | None:
    if not path.is_symlink():
        return None
    target = Path(os.readlink(path))
    if not target.is_absolute():
        target = path.parent / target
    return target.resolve(strict=False)


def is_managed_skill_link(path: Path, config: AgentConfig) -> bool:
    target = symlink_target(path)
    if target is None:
        return False
    try:
        target.relative_to(config.skills_root.resolve(strict=False))
        return True
    except ValueError:
        return False


def is_link_under(path: Path, root: Path) -> bool:
    target = symlink_target(path)
    if target is None:
        return False
    try:
        target.relative_to(root.resolve(strict=False))
        return True
    except ValueError:
        return False


def ensure_symlink(target: Path, link: Path, label: str) -> None:
    if not target.exists():
        raise SystemExit(f"Missing target for {label}: {target}")
    link.parent.mkdir(parents=True, exist_ok=True)
    if link.is_symlink():
        if link.resolve(strict=False) == target.resolve(strict=False):
            print(f"Already linked: {label}")
            return
        print(f"Replacing symlink: {label}")
        link.unlink()
    elif link.exists():
        backup = link.with_name(f"{link.name}.backup")
        suffix = 1
        while backup.exists():
            backup = link.with_name(f"{link.name}.backup.{suffix}")
            suffix += 1
        print(f"Backing up existing {label} to: {backup}")
        shutil.move(str(link), str(backup))
    print(f"Creating symlink: {link} -> {target}")
    link.symlink_to(target)


def remove_managed_link(link: Path, config: AgentConfig, label: str) -> bool:
    if is_managed_skill_link(link, config):
        print(f"Removing symlink: {label}")
        link.unlink()
        return True
    if link.exists() or link.is_symlink():
        print(f"Leaving unmanaged path in place: {link}")
    return False


def installed_names(config: AgentConfig, target_dir: Path) -> set[str]:
    if not target_dir.exists():
        return set()
    return {path.name for path in target_dir.iterdir() if is_managed_skill_link(path, config)}


def validate_skill_names(config: AgentConfig, names: list[str]) -> None:
    known = skill_map(config)
    unknown = [name for name in names if name not in known]
    if unknown:
        raise SystemExit(f"Unknown skill(s) for {config.name}: {', '.join(unknown)}")


def validate_remove_names(config: AgentConfig, names: list[str], target_dir: Path) -> None:
    known = skill_map(config)
    unknown = [
        name
        for name in names
        if name not in known and not is_managed_skill_link(target_dir / name, config)
    ]
    if unknown:
        raise SystemExit(f"Unknown skill(s) for {config.name}: {', '.join(unknown)}")


def refresh_links(config: AgentConfig, target_dir: Path) -> int:
    known = skill_map(config)
    refreshed = 0
    if not target_dir.exists():
        return refreshed
    for link in sorted(target_dir.iterdir()):
        if not is_managed_skill_link(link, config):
            continue
        if link.name not in known:
            print(f"Removing stale managed skill link: {link}")
            link.unlink()
            refreshed += 1
            continue
        ensure_symlink(known[link.name].path, link, f"{config.name} skill '{link.name}'")
        refreshed += 1
    return refreshed


def format_table(rows: list[list[str]]) -> str:
    widths = [max(len(row[idx]) for row in rows) for idx in range(len(rows[0]))]
    lines = []
    for row_idx, row in enumerate(rows):
        lines.append("  ".join(cell.ljust(widths[idx]) for idx, cell in enumerate(row)))
        if row_idx == 0:
            lines.append("  ".join("-" * width for width in widths))
    return "\n".join(lines)


def command_list_skills(args: argparse.Namespace) -> int:
    config = agent_config(args.agent)
    all_skills = skills(config)
    global_installed = installed_names(config, target_skills_dir(config, True))
    target_installed = installed_names(config, target_skills_dir(config, args.global_scope))
    visible_skills = all_skills
    if not args.global_scope:
        visible_skills = [skill for skill in visible_skills if skill.name not in global_installed]
    rows = [["skill", "recommended", "installed", "description"]]
    for skill in visible_skills:
        rows.append([
            skill.name,
            skill.recommended_scope,
            "yes" if skill.name in target_installed else "no",
            skill.description,
        ])
    print(f"Agent: {config.name}")
    print(f"Target: {target_skills_dir(config, args.global_scope)}")
    print(format_table(rows))
    return 0


def command_link_skills(args: argparse.Namespace) -> int:
    config = agent_config(args.agent)
    if args.add_all and args.add:
        raise SystemExit("--add-all cannot be combined with --add")
    if args.remove_all and args.remove:
        raise SystemExit("--remove-all cannot be combined with --remove")
    if (args.add_all or args.add) and (args.remove_all or args.remove):
        raise SystemExit("Add and remove operations cannot be combined")
    add = args.add or []
    remove = args.remove or []
    target_dir = target_skills_dir(config, args.global_scope)
    known = skill_map(config)
    if args.add_all:
        add = list(known)
    if args.remove_all:
        remove = sorted(installed_names(config, target_dir))
    validate_skill_names(config, add)
    validate_remove_names(config, remove, target_dir)
    if args.remove_all and not remove:
        print(f"Removed 0 managed {config.name} skill link(s) in {target_dir}.")
        return 0
    if not add and not remove:
        count = refresh_links(config, target_dir)
        print(f"Refreshed {count} managed {config.name} skill link(s) in {target_dir}.")
        return 0
    for name in remove:
        remove_managed_link(target_dir / name, config, f"{config.name} skill '{name}'")
    for name in add:
        ensure_symlink(known[name].path, target_dir / name, f"{config.name} skill '{name}'")
    return 0


def write_starter_codex_user_agents() -> None:
    user_agents = codex_dir() / "user" / "AGENTS.md"
    if user_agents.exists():
        print(f"User AGENTS source exists: {user_agents}")
        return
    print(f"Creating starter user AGENTS source: {user_agents}")
    user_agents.parent.mkdir(parents=True, exist_ok=True)
    user_agents.write_text(
        "Add personal Codex preferences here. This file is preserved by setup.\n",
        encoding="utf-8",
    )


def command_render_override(args: argparse.Namespace) -> int:
    if args.agent != "codex":
        raise SystemExit("render-override is only used for --agent codex")
    code_dir = codex_dir()
    user_agents = code_dir / "user" / "AGENTS.md"
    content_agents = agent_config("codex").global_prompt
    output = code_dir / "AGENTS.override.md"
    if not user_agents.exists():
        raise SystemExit(f"Missing user AGENTS source: {user_agents}")
    if not content_agents.exists():
        raise SystemExit(f"Missing content AGENTS source: {content_agents}")
    output.parent.mkdir(parents=True, exist_ok=True)
    if args.first_run and output.exists():
        current = output.read_text(encoding="utf-8", errors="replace")
        if (
            GENERATED_MARKER not in current
            and OLD_CODEX_MARKER not in current
            and OLD_CODEX_MARKER_2 not in current
        ):
            raise SystemExit(
                "Refusing to overwrite existing unmanaged AGENTS.override.md during first-run setup:\n"
                f"{output}"
            )
    rendered = (
        "<!--\n"
        f"{GENERATED_MARKER}. Do not edit directly.\n\n"
        "Sources:\n"
        f"- {user_agents}\n"
        f"- {content_agents}\n\n"
        "Regenerate after editing either source by running:\n"
        f"{code_dir / 'bin' / 'config-agent-tool'} render-override --agent codex\n"
        "-->\n\n"
        "# User Global Instructions\n\n"
        f"{user_agents.read_text(encoding='utf-8')}\n"
        "# Shared Codex Instructions\n\n"
        f"{content_agents.read_text(encoding='utf-8')}"
    )
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=output.parent,
        delete=False,
        prefix=f"{output.name}.",
        suffix=".tmp",
    ) as tmp:
        tmp.write(rendered)
        tmp_path = Path(tmp.name)
    tmp_path.replace(output)
    print(f"Rendered {output}")
    return 0


def ensure_claude_import() -> None:
    cdir = claude_dir()
    cdir.mkdir(parents=True, exist_ok=True)
    claude_md = cdir / "CLAUDE.md"
    import_line = f"@{agent_config('claude').global_prompt}"
    stale_import_lines = {f"@{repo_dir() / 'global' / 'CLAUDE.md'}"}
    if claude_md.is_symlink():
        print(f"Backing up symlinked CLAUDE.md to {claude_md}.backup")
        backup = claude_md.with_name("CLAUDE.md.backup")
        suffix = 1
        while backup.exists():
            backup = claude_md.with_name(f"CLAUDE.md.backup.{suffix}")
            suffix += 1
        claude_md.rename(backup)
    if claude_md.exists():
        text = claude_md.read_text(encoding="utf-8", errors="replace")
        lines = text.splitlines()
        repaired_lines = []
        changed = False
        import_seen = False
        stale_replaced = False
        for line in lines:
            stripped = line.strip()
            if stripped in stale_import_lines:
                changed = True
                if not import_seen:
                    repaired_lines.append(import_line)
                    import_seen = True
                    stale_replaced = True
                continue
            if stripped == import_line:
                if import_seen:
                    changed = True
                    continue
                repaired_lines.append(import_line)
                import_seen = True
                changed = changed or line != import_line
                continue
            repaired_lines.append(line)
        if import_seen:
            if changed:
                claude_md.write_text("\n".join(repaired_lines) + "\n", encoding="utf-8")
                if stale_replaced:
                    print(f"Repaired stale Claude import in {claude_md}")
                else:
                    print(f"Normalized Claude import in {claude_md}")
                return
            print("Claude import already present.")
            return
        with claude_md.open("a", encoding="utf-8") as handle:
            handle.write("\n# Import shared lab agent configuration\n")
            handle.write(import_line + "\n")
        print(f"Added Claude import to {claude_md}")
    else:
        claude_md.write_text(
            "# User Claude Configuration\n\n"
            "# Import shared lab agent configuration\n"
            f"{import_line}\n",
            encoding="utf-8",
        )
        print(f"Created {claude_md}")


def claude_settings_template() -> Path:
    return agent_config("claude").root / "global" / "settings.json"


def strip_legacy_claude_hooks(settings: dict) -> bool:
    """Drop the exact legacy hook commands previously managed by this repo.

    Those hooks are delivered by the lab-config plugin now; leaving them in the
    user's settings.json would make them fire twice. Other commands under
    ~/.claude/hooks/ may be user-authored and are preserved.
    """
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return False
    changed = False
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for group in groups:
            if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
                kept_groups.append(group)
                continue
            kept_hooks = [
                hook
                for hook in group["hooks"]
                if not (
                    isinstance(hook, dict)
                    and hook.get("command") in CLAUDE_LEGACY_HOOK_COMMANDS
                )
            ]
            if len(kept_hooks) != len(group["hooks"]):
                changed = True
            if kept_hooks:
                kept_groups.append({**group, "hooks": kept_hooks})
        if len(kept_groups) != len(groups):
            changed = True
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if not hooks:
        settings.pop("hooks", None)
    return changed


def materialize_claude_settings() -> None:
    """Ensure ~/.claude/settings.json is a user-owned regular file.

    Interactive Claude Code changes (/model, /config, permission grants) write
    to this file, so it must not be a symlink into the repo. Repo-managed hooks
    are delivered by the lab-config plugin instead.
    """
    settings = claude_dir() / "settings.json"
    template = claude_settings_template()
    if settings.is_symlink():
        if not is_link_under(settings, repo_dir()):
            print(
                f"Warning: leaving unmanaged Claude settings symlink in place: {settings}",
                file=sys.stderr,
            )
            return
        source = settings if settings.exists() else template
        try:
            content = json.loads(source.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            content = json.loads(template.read_text(encoding="utf-8"))
        settings.unlink()
        strip_legacy_claude_hooks(content)
        settings.write_text(json.dumps(content, indent=2) + "\n", encoding="utf-8")
        print(f"Converted Claude settings symlink to user-owned file: {settings}")
        return
    if settings.exists():
        try:
            content = json.loads(settings.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            print(
                f"Warning: could not parse user-owned Claude settings, leaving as-is: {settings}",
                file=sys.stderr,
            )
            return
        if strip_legacy_claude_hooks(content):
            settings.write_text(json.dumps(content, indent=2) + "\n", encoding="utf-8")
            print(f"Removed legacy repo-managed hooks from user settings: {settings}")
        else:
            print(f"User-owned Claude settings present: {settings}")
        return
    content = json.loads(template.read_text(encoding="utf-8"))
    strip_legacy_claude_hooks(content)
    settings.write_text(json.dumps(content, indent=2) + "\n", encoding="utf-8")
    print(f"Seeded Claude settings from repo template: {settings}")


def repair_claude_managed_surface() -> None:
    cdir = claude_dir()
    for path in [cdir, cdir / "skills"]:
        path.mkdir(parents=True, exist_ok=True)
    ensure_claude_import()
    materialize_claude_settings()
    ensure_symlink(
        agent_config("claude").root / "plugin" / CLAUDE_PLUGIN_NAME,
        cdir / "skills" / CLAUDE_PLUGIN_NAME,
        "Claude lab-config plugin",
    )
    ensure_symlink(agent_config("claude").root / "hooks", cdir / "hooks", "Claude hooks")
    ensure_symlink(
        repo_dir() / "bin" / "config-agent-tool",
        cdir / "bin" / "config-agent-tool",
        "config-agent-tool",
    )


def codex_hooks_sidecar(code_dir: Path) -> Path:
    return code_dir / ".hooks.json.rendered"


def codex_hooks_json_is_managed(code_dir: Path, path: Path) -> bool:
    if is_link_under(path, repo_dir()):
        return True
    sidecar = codex_hooks_sidecar(code_dir)
    try:
        expected = sidecar.read_text(encoding="utf-8").strip()
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        return False
    return bool(expected) and expected == actual


def render_codex_hooks_content(code_dir: Path) -> str:
    """Compose hooks.json from the repo fragment plus the user's optional fragment.

    Event lists concatenate, repo hooks first, so users can add personal Codex
    hooks in ~/.codex/user/hooks.json without forking the managed file.
    """
    merged: dict = {"hooks": {}}
    fragments = [agent_config("codex").root / "global" / "hooks.json"]
    user_fragment = code_dir / "user" / "hooks.json"
    if user_fragment.exists():
        fragments.append(user_fragment)
    for fragment in fragments:
        try:
            data = json.loads(fragment.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise CodexHooksFragmentError(
                f"could not read hooks fragment: {fragment}"
            ) from exc
        if not isinstance(data, dict):
            raise CodexHooksFragmentError(
                f"hooks fragment is not a JSON object: {fragment}"
            )
        events = data.get("hooks", {})
        if not isinstance(events, dict):
            raise CodexHooksFragmentError(
                f"hooks fragment has no hooks object: {fragment}"
            )
        for event, groups in events.items():
            if not isinstance(groups, list):
                raise CodexHooksFragmentError(
                    f"hooks event {event!r} is not a list in fragment: {fragment}"
                )
            for group in groups:
                if not isinstance(group, dict):
                    raise CodexHooksFragmentError(
                        f"hooks event {event!r} has a non-object group in fragment: {fragment}"
                    )
                hooks = group.get("hooks")
                if not isinstance(hooks, list):
                    raise CodexHooksFragmentError(
                        f"hooks event {event!r} has a group without a hooks list in fragment: {fragment}"
                    )
                if not all(isinstance(hook, dict) for hook in hooks):
                    raise CodexHooksFragmentError(
                        f"hooks event {event!r} has a non-object hook in fragment: {fragment}"
                    )
            merged["hooks"].setdefault(event, []).extend(groups)
    return json.dumps(merged, indent=2) + "\n"


def codex_hooks_json_contains_update_hook(path: Path) -> bool:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    session_start = data.get("hooks", {}).get("SessionStart", [])
    if not isinstance(session_start, list):
        return False
    for group in session_start:
        if not isinstance(group, dict) or group.get("matcher") != "startup":
            continue
        for hook in group.get("hooks", []):
            if not isinstance(hook, dict):
                continue
            if hook.get("type") == "command" and hook.get("command") == CODEX_UPDATE_HOOK_COMMAND:
                return True
    return False


def codex_unmanaged_message(path: Path, first_run: bool, label: str, recovery: str) -> str:
    prefix = (
        f"Refusing to overwrite existing unmanaged {label} during first-run setup:\n"
        if first_run
        else f"Warning: leaving unmanaged Codex {label} in place during update:\n"
    )
    return f"{prefix}{path}\n{recovery}"


def repair_codex_hooks_json(code_dir: Path, first_run: bool) -> list[str]:
    hooks_json = code_dir / "hooks.json"
    if not (hooks_json.exists() or hooks_json.is_symlink()) or codex_hooks_json_is_managed(
        code_dir, hooks_json
    ):
        try:
            rendered = render_codex_hooks_content(code_dir)
        except CodexHooksFragmentError as exc:
            message = f"Cannot render Codex hooks.json: {exc}"
            if hooks_json.exists() or hooks_json.is_symlink():
                print(f"Warning: {message}; keeping existing hooks.json", file=sys.stderr)
                return []
            if first_run:
                return [message]
            print(f"Warning: {message}", file=sys.stderr)
            return []
        if hooks_json.is_symlink():
            hooks_json.unlink()
        hooks_json.write_text(rendered, encoding="utf-8")
        codex_hooks_sidecar(code_dir).write_text(
            hashlib.sha256(rendered.encode("utf-8")).hexdigest() + "\n", encoding="utf-8"
        )
        print(f"Rendered Codex hooks.json: {hooks_json}")
        return []
    if codex_hooks_json_contains_update_hook(hooks_json):
        print(f"Leaving unmanaged Codex hooks.json with startup update hook in place: {hooks_json}")
        return []
    message = codex_unmanaged_message(
        hooks_json,
        first_run,
        "hooks.json",
        "With your permission, the setup agent can move your personal hook entries "
        "into ~/.codex/user/hooks.json (they will be merged into the rendered "
        "hooks.json) or manually merge this repo's SessionStart startup hook into "
        "that file. After that, rerun install --agent codex to finish setup.",
    )
    if not first_run:
        print(message, file=sys.stderr)
        return []
    return [message]


def repair_codex_hooks_dir(code_dir: Path, first_run: bool) -> list[str]:
    hooks_dir = code_dir / "hooks"
    if not (hooks_dir.exists() or hooks_dir.is_symlink()) or is_link_under(hooks_dir, repo_dir()):
        ensure_symlink(agent_config("codex").root / "hooks", hooks_dir, "Codex hooks")
        return []
    message = codex_unmanaged_message(
        hooks_dir,
        first_run,
        "hooks directory",
        "With your permission, the setup agent can manually merge or move the existing "
        "hook scripts before installing this repo's Codex startup update script.",
    )
    if first_run:
        return [message]
    print(message, file=sys.stderr)
    return []


def repair_codex_managed_surface(first_run: bool) -> None:
    code_dir = codex_dir()
    for path in [code_dir, code_dir / "user", code_dir / "skills", code_dir / "bin"]:
        path.mkdir(parents=True, exist_ok=True)
    write_starter_codex_user_agents()
    ensure_symlink(
        repo_dir() / "bin" / "config-agent-tool",
        code_dir / "bin" / "config-agent-tool",
        "config-agent-tool",
    )
    command_render_override(argparse.Namespace(agent="codex", first_run=first_run))
    issues = []
    issues.extend(repair_codex_hooks_json(code_dir, first_run))
    issues.extend(repair_codex_hooks_dir(code_dir, first_run))
    if first_run and issues:
        raise SystemExit("\n\n".join(issues))


def install_claude() -> int:
    repair_claude_managed_surface()
    print("Install complete. No skills were installed automatically.")
    return 0


def install_codex() -> int:
    repair_codex_managed_surface(first_run=True)
    print("Install complete. No skills were installed automatically.")
    return 0


def managed_install_present(name: str) -> bool:
    """Return whether this repo already manages any surface for an agent."""
    if name == "claude":
        cdir = claude_dir()
        return any(
            (
                (cdir / "bin" / "config-agent-tool").exists(),
                (cdir / "bin" / "config-agent-tool").is_symlink(),
                is_link_under(cdir / "settings.json", repo_dir()),
                is_link_under(cdir / "skills" / CLAUDE_PLUGIN_NAME, repo_dir()),
                is_link_under(cdir / "hooks", repo_dir()),
            )
        )
    if name == "codex":
        code_dir = codex_dir()
        override = code_dir / "AGENTS.override.md"
        override_is_managed = False
        if override.exists():
            with contextlib.suppress(OSError):
                content = override.read_text(encoding="utf-8")
                override_is_managed = any(
                    marker in content
                    for marker in (GENERATED_MARKER, OLD_CODEX_MARKER, OLD_CODEX_MARKER_2)
                )
        return any(
            (
                (code_dir / "bin" / "config-agent-tool").exists(),
                (code_dir / "bin" / "config-agent-tool").is_symlink(),
                override_is_managed,
                codex_hooks_sidecar(code_dir).exists(),
                is_link_under(code_dir / "hooks", repo_dir()),
            )
        )
    raise SystemExit(f"Unknown agent: {name}")


def refresh_agent(name: str, *, first_run: bool) -> None:
    config = agent_config(name)
    if name == "claude":
        repair_claude_managed_surface()
    elif name == "codex":
        repair_codex_managed_surface(first_run=first_run)
    else:
        raise SystemExit(f"Unknown agent: {name}")
    global_count = refresh_links(config, target_skills_dir(config, True))
    print(f"Refreshed {global_count} global {config.name} skill link(s).")
    project_target = target_skills_dir(config, False)
    if project_target.exists():
        project_count = refresh_links(config, project_target)
        print(f"Refreshed {project_count} project {config.name} skill link(s).")


def command_install(args: argparse.Namespace) -> int:
    if args.agent == "claude":
        return install_claude()
    if args.agent == "codex":
        return install_codex()
    raise SystemExit(f"Unknown agent: {args.agent}")


def command_update(args: argparse.Namespace) -> int:
    config = agent_config(args.agent)
    try:
        git_pull_ff_only()
    except subprocess.CalledProcessError:
        if config.name == "codex":
            repair_codex_managed_surface(first_run=False)
        if config.name == "claude":
            repair_claude_managed_surface()
        raise
    refresh_agent(config.name, first_run=False)
    return 0


def command_setup(args: argparse.Namespace) -> int:
    if args.agent != "both":
        raise SystemExit(f"Unknown setup target: {args.agent}")
    if not args.after_pull:
        git_pull_ff_only()
        os.execv(
            sys.executable,
            [
                sys.executable,
                str(repo_dir() / "bin" / "config-agent-tool"),
                "setup",
                "--agent",
                "both",
                "--after-pull",
            ],
        )
    existing = {name: managed_install_present(name) for name in sorted(AGENTS)}
    # Run stricter first-time Codex checks before touching a fresh Claude home.
    order = ("codex", "claude") if not existing["codex"] else ("claude", "codex")
    for name in order:
        action = "Updating existing" if existing[name] else "Installing first-time"
        print(f"{action} {name} configuration.")
        refresh_agent(name, first_run=not existing[name])
    print("Claude and Codex setup/update complete. No new skills were installed automatically.")
    return 0


def command_repo_dir(args: argparse.Namespace) -> int:
    print(repo_dir())
    return 0


def add_agent_arg(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--agent", required=True, choices=sorted(AGENTS))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="config-agent-tool")
    subcommands = parser.add_subparsers(dest="command", required=True)

    install = subcommands.add_parser("install")
    add_agent_arg(install)
    install.set_defaults(func=command_install)

    list_skills = subcommands.add_parser("list-skills")
    add_agent_arg(list_skills)
    list_skills.add_argument("--global", dest="global_scope", action="store_true")
    list_skills.set_defaults(func=command_list_skills)

    link_skills = subcommands.add_parser("link-skills")
    add_agent_arg(link_skills)
    link_skills.add_argument("--global", dest="global_scope", action="store_true")
    link_skills.add_argument("--add", nargs="+")
    link_skills.add_argument("--add-all", action="store_true")
    link_skills.add_argument("--remove", nargs="+")
    link_skills.add_argument("--remove-all", action="store_true")
    link_skills.set_defaults(func=command_link_skills)

    render = subcommands.add_parser("render-override")
    add_agent_arg(render)
    render.add_argument("--first-run", action="store_true")
    render.set_defaults(func=command_render_override)

    update = subcommands.add_parser("update")
    add_agent_arg(update)
    update.set_defaults(func=command_update)

    setup = subcommands.add_parser("setup")
    setup.add_argument("--agent", required=True, choices=["both"])
    setup.add_argument("--after-pull", action="store_true", help=argparse.SUPPRESS)
    setup.set_defaults(func=command_setup)

    repo = subcommands.add_parser("repo-dir")
    repo.set_defaults(func=command_repo_dir)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
